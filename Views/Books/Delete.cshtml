@model Book
@{
    ViewData["Title"] = "Xóa sách";
}

<section class="lib-page-header mb-4 d-flex flex-wrap justify-content-between align-items-center gap-3">
    <div>
        <span class="badge text-bg-danger mb-2">Xác nhận xóa</span>
        <h1 class="h3 fw-bold mb-1">Xóa sách "@Model.Title"?</h1>
        <p class="text-white-50 mb-0 small">Thao tác không hoàn tác được. Sách đã có trong phiếu mượn sẽ không xóa được.</p>
    </div>
    <a class="btn-lib btn-lib-ghost" asp-action="Index"><span>← Về kho sách</span></a>
</section>

<div class="lib-panel p-4">
    <dl class="row">
        <dt class="col-sm-3 text-muted">@Html.DisplayNameFor(m => m.Title)</dt>
        <dd class="col-sm-9 fw-semibold">@Model.Title</dd>
        <dt class="col-sm-3 text-muted">@Html.DisplayNameFor(m => m.Author)</dt>
        <dd class="col-sm-9">@Model.Author</dd>
        <dt class="col-sm-3 text-muted">@Html.DisplayNameFor(m => m.CategoryId)</dt>
        <dd class="col-sm-9">@(Model.Category?.Name ?? "Chưa phân loại")</dd>
        <dt class="col-sm-3 text-muted">@Html.DisplayNameFor(m => m.Quantity)</dt>
        <dd class="col-sm-9">@Model.Quantity (còn @Model.Available)</dd>
    </dl>
    <form asp-action="Delete" asp-route-id="@Model.Id" method="post" class="d-flex gap-2">
        <button type="submit" class="btn btn-danger fw-semibold">Xác nhận xóa</button>
        <a class="btn-lib btn-lib-outline" asp-action="Index">Hủy</a>
    </form>
</div>
