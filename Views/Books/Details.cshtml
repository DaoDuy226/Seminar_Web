@model LibraryManagement.Models.Book

@{
    ViewData["Title"] = "Chi tiết Sách";
}

<div class="container-fluid px-4 py-3">
    <div class="mb-4">
        <span class="badge text-bg-info text-dark mb-1">Thông tin chi tiết</span>
        <h1 class="h3 fw-bold mb-1">Chi tiết Sách</h1>
        <p class="text-muted small mb-0">Xem thông tin chi tiết đầu sách trong hệ thống.</p>
    </div>

    <div class="card shadow-sm border-0 mb-4 col-md-8">
        <div class="card-body">
            <dl class="row mb-0">
                <dt class="col-sm-3 text-muted">Tên sách:</dt>
                <dd class="col-sm-9 fw-semibold fs-5">@Html.DisplayFor(model => model.Title)</dd>

                <dt class="col-sm-3 text-muted">Tác giả:</dt>
                <dd class="col-sm-9">@Html.DisplayFor(model => model.Author)</dd>

                <dt class="col-sm-3 text-muted">Thể loại:</dt>
                <dd class="col-sm-9">@(Model.Category?.Name ?? "Chưa phân loại")</dd>

                <dt class="col-sm-3 text-muted">Tổng số lượng:</dt>
                <dd class="col-sm-9">@Html.DisplayFor(model => model.Quantity)</dd>

                <dt class="col-sm-3 text-muted">Số lượng còn lại:</dt>
                <dd class="col-sm-9">
                    <span class="badge @(Model.Available > 0 ? "bg-success" : "bg-danger")">
                        @Model.Available
                    </span>
                </dd>

                <dt class="col-sm-3 text-muted">Năm xuất bản:</dt>
                <dd class="col-sm-9">@Html.DisplayFor(model => model.PublishYear)</dd>
            </dl>
        </div>
        <div class="card-footer bg-light d-flex gap-2 py-3">
            <a asp-action="Edit" asp-route-id="@Model?.Id" class="btn btn-warning fw-semibold px-4">Sửa</a>
            <a asp-action="Index" class="btn btn-outline-secondary px-4">Quay lại danh sách</a>
        </div>
    </div>
</div>