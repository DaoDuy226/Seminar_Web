@model LibraryManagement.Models.Book

@{
    ViewData["Title"] = "Chỉnh sửa Sách";
}

<div class="container-fluid px-4 py-3">
    <div class="mb-4">
        <span class="badge text-bg-warning text-dark mb-1">Quản trị hệ thống</span>
        <h1 class="h3 fw-bold mb-1">Chỉnh sửa thông tin sách</h1>
        <p class="text-muted small mb-0">Cập nhật thông tin chi tiết cho đầu sách trong thư viện.</p>
    </div>

    <div class="card shadow-sm border-0 mb-4 col-md-8">
        <div class="card-body">
            <form asp-action="Edit">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                <input type="hidden" asp-for="Id" />

                <div class="mb-3">
                    <label asp-for="Title" class="form-label fw-semibold text-muted">Tên sách</label>
                    <input asp-for="Title" class="form-control" placeholder="Nhập tên sách..." />
                    <span asp-validation-for="Title" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Author" class="form-label fw-semibold text-muted">Tác giả</label>
                    <input asp-for="Author" class="form-control" placeholder="Nhập tên tác giả..." />
                    <span asp-validation-for="Author" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="CategoryId" class="form-label fw-semibold text-muted">Thể loại</label>
                    <select asp-for="CategoryId" class="form-select" asp-items="ViewBag.CategoryId"></select>
                    <span asp-validation-for="CategoryId" class="text-danger"></span>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="Quantity" class="form-label fw-semibold text-muted">Tổng số lượng</label>
                        <input asp-for="Quantity" class="form-control" />
                        <span asp-validation-for="Quantity" class="text-danger"></span>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label asp-for="Available" class="form-label fw-semibold text-muted">Số lượng còn lại</label>
                        <input asp-for="Available" class="form-control" />
                        <span asp-validation-for="Available" class="text-danger"></span>
                    </div>
                </div>

                <div class="mb-4">
                    <label asp-for="PublishYear" class="form-label fw-semibold text-muted">Năm xuất bản</label>
                    <input asp-for="PublishYear" class="form-control" />
                    <span asp-validation-for="PublishYear" class="text-danger"></span>
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-warning fw-semibold px-4">Lưu thay đổi</button>
                    <a asp-action="Index" class="btn btn-outline-secondary px-4">Quay lại danh sách</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}