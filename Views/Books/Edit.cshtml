@model Book
@{
    ViewData["Title"] = "Sửa sách";
    var borrowed = Model.Quantity - Model.Available;
}

<section class="lib-page-header mb-4 d-flex flex-wrap justify-content-between align-items-center gap-3">
    <div>
        <span class="badge text-bg-warning text-dark mb-2">Kho sách</span>
        <h1 class="h3 fw-bold mb-1">Sửa sách #@Model.Id</h1>
        <p class="text-white-50 mb-0 small">Hiện còn @Model.Available / @Model.Quantity cuốn trong kho, @borrowed cuốn đang được mượn.</p>
    </div>
    <a class="btn-lib btn-lib-ghost" asp-action="Index"><span>← Về kho sách</span></a>
</section>

<div class="lib-panel p-4">
    <form asp-action="Edit" asp-route-id="@Model.Id" method="post">
        <input type="hidden" asp-for="Id" />
        <partial name="_BookForm" model="Model" />
        <p class="small text-muted mt-3 mb-0">
            Khi đổi tổng số lượng, số lượng còn lại được tự tính lại (giữ nguyên số cuốn đang được mượn).
        </p>
        <div class="d-flex gap-2 mt-4">
            <button type="submit" class="btn-lib btn-lib-navy">Lưu thay đổi</button>
            <a class="btn-lib btn-lib-outline" asp-action="Index">Hủy</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
