@* Partial dùng chung: thông báo kết quả thao tác (thêm / sửa / xóa / mượn / trả).
   Controller gán TempData["SuccessMessage"] hoặc TempData["ErrorMessage"] trước khi RedirectToAction;
   TempData còn sống qua đúng một lần redirect nên trang đích đọc được. *@
@if (TempData["SuccessMessage"] is string success)
{
    <div class="alert alert-success alert-dismissible fade show border-2 shadow-sm mb-4" role="status">
        <strong>Thành công:</strong> @success
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Đóng"></button>
    </div>
}
@if (TempData["ErrorMessage"] is string error)
{
    <div class="alert alert-warning alert-dismissible fade show border-2 shadow-sm mb-4" role="alert">
        <strong>Không thực hiện được:</strong> @error
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Đóng"></button>
    </div>
}
