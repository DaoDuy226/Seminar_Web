@model Reader
@{
    ViewData["Title"] = "Xóa độc giả";
    var borrowCount = ViewBag.BorrowCount as int? ?? 0;
}

<section class="lib-page-header mb-4 d-flex flex-wrap justify-content-between align-items-center gap-3">
    <div>
        <span class="badge text-bg-danger mb-2">Xác nhận xóa</span>
        <h1 class="h3 fw-bold mb-1">Xóa độc giả "@Model.FullName"?</h1>
        <p class="text-white-50 mb-0 small">Thao tác không hoàn tác được. Độc giả đã có phiếu mượn sẽ không xóa được.</p>
    </div>
    <a class="btn-lib btn-lib-ghost" asp-action="Index"><span>← Về danh sách độc giả</span></a>
</section>

<div class="lib-panel p-4">
    @if (borrowCount > 0)
    {
        <div class="alert alert-warning mb-3" role="alert">
            Độc giả này đã có @borrowCount phiếu mượn nên hệ thống sẽ không cho xóa (để giữ lịch sử mượn trả).
        </div>
    }
    <dl class="row">
        <dt class="col-sm-3 text-muted">@Html.DisplayNameFor(m => m.FullName)</dt>
        <dd class="col-sm-9 fw-semibold">@Model.FullName</dd>
        <dt class="col-sm-3 text-muted">@Html.DisplayNameFor(m => m.Phone)</dt>
        <dd class="col-sm-9">@Model.Phone</dd>
        <dt class="col-sm-3 text-muted">@Html.DisplayNameFor(m => m.Email)</dt>
        <dd class="col-sm-9">@Model.Email</dd>
    </dl>
    <form asp-action="Delete" asp-route-id="@Model.Id" method="post" class="d-flex gap-2">
        <button type="submit" class="btn btn-danger fw-semibold" disabled="@(borrowCount > 0)">Xác nhận xóa</button>
        <a class="btn-lib btn-lib-outline" asp-action="Index">Hủy</a>
    </form>
</div>
