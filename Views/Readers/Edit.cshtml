@model LibraryManagement.Models.Reader

@{
    ViewData["Title"] = "Chỉnh sửa Độc giả";
}

<div class="container-fluid px-4 py-3">
    <div class="mb-4">
        <span class="badge text-bg-warning text-dark mb-1">Quản trị hệ thống</span>
        <h1 class="h3 fw-bold mb-1">Chỉnh sửa thông tin độc giả</h1>
        <p class="text-muted small mb-0">Cập nhật thông tin liên hệ cho thành viên thư viện.</p>
    </div>

    <div class="card shadow-sm border-0 mb-4 col-md-8">
        <div class="card-body">
            <form asp-action="Edit">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                <input type="hidden" asp-for="Id" />

                <div class="mb-3">
                    <label asp-for="FullName" class="form-label fw-semibold text-muted">Họ và tên</label>
                    <input asp-for="FullName" class="form-control" placeholder="Nhập họ tên độc giả..." />
                    <span asp-validation-for="FullName" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Phone" class="form-label fw-semibold text-muted">Số điện thoại</label>
                    <input asp-for="Phone" class="form-control" placeholder="Nhập số điện thoại..." />
                    <span asp-validation-for="Phone" class="text-danger"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="Email" class="form-label fw-semibold text-muted">Email</label>
                    <input asp-for="Email" class="form-control" placeholder="Nhập địa chỉ email..." />
                    <span asp-validation-for="Email" class="text-danger"></span>
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-warning fw-semibold px-4">Lưu thay đổi</button>
                    <a asp-action="Index" class="btn btn-outline-secondary px-4">Quay lại danh sách</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}