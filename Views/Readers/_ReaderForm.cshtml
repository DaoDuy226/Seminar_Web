@model Reader
@* Partial dùng chung cho form Thêm và Sửa độc giả. *@
<div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 mb-3" role="alert"></div>
<div class="row g-3">
    <div class="col-md-12">
        <label asp-for="FullName" class="form-label fw-semibold"></label>
        <input asp-for="FullName" class="form-control" placeholder="Nguyễn Văn A" />
        <span asp-validation-for="FullName" class="text-danger small"></span>
    </div>
    <div class="col-md-6">
        <label asp-for="Phone" class="form-label fw-semibold"></label>
        <input asp-for="Phone" class="form-control" placeholder="0901234567" />
        <span asp-validation-for="Phone" class="text-danger small"></span>
    </div>
    <div class="col-md-6">
        <label asp-for="Email" class="form-label fw-semibold"></label>
        <input asp-for="Email" class="form-control" placeholder="ten@example.com" />
        <span asp-validation-for="Email" class="text-danger small"></span>
    </div>
</div>
