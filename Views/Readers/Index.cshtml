@model List<LibraryManagement.Models.ViewModels.ReaderSummaryItem>
@{
    ViewData["Title"] = "Quản lý Độc giả";
}

<section class="lib-page-header mb-4 d-flex flex-wrap justify-content-between align-items-center gap-3">
    <div>
        <span class="badge text-bg-warning text-dark mb-2">Thành viên thư viện</span>
        <h1 class="h3 fw-bold mb-1">Danh sách Độc giả (@Model.Count)</h1>
        <p class="text-white-50 mb-0 small">Thông tin liên hệ độc giả và tình trạng mượn sách hiện tại.</p>
    </div>
    <a class="btn-lib btn-lib-ghost" asp-controller="Home" asp-action="Index">
        <span>← Về Dashboard</span>
    </a>
</section>

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<!-- Thanh tìm kiếm độc giả -->
<div class="lib-panel p-3 p-md-4 mb-4">
    <form method="get" asp-controller="Readers" asp-action="Index" class="row g-3 align-items-end">
        <div class="col-md-8">
            <label class="form-label fw-semibold small" for="searchString">Tìm kiếm độc giả</label>
            <input id="searchString" name="searchString" value="@ViewData["CurrentFilter"]" class="form-control" placeholder="Nhập họ tên hoặc số điện thoại cần tìm..." />
        </div>
        <div class="col-md-4 d-flex gap-2">
            <button type="submit" class="btn btn-dark w-100 fw-semibold">Tìm kiếm</button>
            <a class="btn btn-outline-secondary" asp-controller="Readers" asp-action="Index" title="Xóa bộ lọc">↺</a>
        </div>
    </form>
</div>

<div class="lib-panel">
    <div class="table-responsive">
        <table class="table lib-table align-middle mb-0">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Họ và tên</th>
                    <th>Số điện thoại</th>
                    <th>Email</th>
                    <th class="text-center">Tổng lượt mượn</th>
                    <th class="text-center">Tình trạng</th>
                    <th class="text-end">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="7" class="text-center py-4 text-muted">Không tìm thấy độc giả nào phù hợp.</td>
                    </tr>
                }
                else
                {
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="text-muted">#@item.Reader.Id</td>
                            <td class="fw-semibold">@item.Reader.FullName</td>
                            <td>@item.Reader.Phone</td>
                            <td>@item.Reader.Email</td>
                            <td class="text-center">@item.TotalBorrowCount</td>
                            <td class="text-center">
                                @if (item.OverdueBorrowCount > 0)
                                {
                                    <span class="badge rounded-pill text-bg-danger">Có @item.OverdueBorrowCount phiếu quá hạn</span>
                                }
                                else if (item.ActiveBorrowCount > 0)
                                {
                                    <span class="badge rounded-pill text-bg-warning">Đang mượn (@item.ActiveBorrowCount)</span>
                                }
                                else
                                {
                                    <span class="badge rounded-pill text-bg-success">Không nợ sách</span>
                                }
                            </td>
                            <td class="text-end">
                                <a class="btn-lib btn-lib-outline btn-sm py-1 px-3 text-decoration-none"
                                   asp-controller="Readers" asp-action="Details" asp-route-id="@item.Reader.Id">
                                    <span>Xem phiếu mượn</span>
                                    <span class="lib-arrow">→</span>
                                </a>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>