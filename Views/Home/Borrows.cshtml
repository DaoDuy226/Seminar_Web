@model List<BorrowRecord>
@{
    ViewData["Title"] = "Mượn / Trả sách";
}

<section class="lib-page-header mb-4 d-flex flex-wrap justify-content-between align-items-center gap-3">
    <div>
        <span class="badge text-bg-warning text-dark mb-2">Nghiệp vụ lưu thông</span>
        <h1 class="h3 fw-bold mb-1">Tất cả Phiếu Mượn / Trả (@Model.Count)</h1>
        <p class="text-white-50 mb-0 small">Danh sách toàn bộ phiếu mượn sách trong hệ thống.</p>
    </div>
    <div class="d-flex flex-wrap gap-2">
        <a class="btn-lib btn-lib-ghost" asp-controller="Home" asp-action="Index"><span>← Về Dashboard</span></a>
        <a class="btn-lib btn-lib-amber" asp-controller="Borrows" asp-action="Create"><span>+ Lập phiếu mượn</span></a>
    </div>
</section>

<partial name="_StatusMessages" />

<partial name="_DatabaseErrorAlert" />

<div class="lib-panel p-3 p-md-4 mb-4">
    <form method="get" asp-controller="Home" asp-action="Borrows" class="row g-3 align-items-end">
        <div class="col-md-10">
            <label class="form-label fw-semibold small" for="search">Tìm kiếm phiếu mượn</label>
            <input id="search" name="search" value="@ViewData["CurrentFilter"]" class="form-control"
                   placeholder="Nhập mã phiếu (vd: 3 hoặc #3), tên độc giả, số điện thoại hoặc tên sách..." />
        </div>
        <div class="col-md-2 d-flex gap-2">
            <button type="submit" class="btn-lib btn-lib-navy w-100">Tìm</button>
            <a class="btn-lib btn-lib-outline" asp-controller="Home" asp-action="Borrows" title="Xóa bộ lọc">↺</a>
        </div>
    </form>
</div>

<div class="lib-panel">
    <div class="table-responsive">
        <table class="table lib-table align-middle mb-0">
            <thead>
                <tr>
                    <th>Mã phiếu</th>
                    <th>Độc giả</th>
                    <th>Chi tiết sách mượn</th>
                    <th>Ngày mượn</th>
                    <th>Hạn trả</th>
                    <th>Ngày trả thực tế</th>
                    <th>Trạng thái</th>
                    <th>Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Count == 0 && ViewBag.DatabaseError == null)
                {
                    <tr><td colspan="8" class="text-center text-muted">@(string.IsNullOrWhiteSpace(ViewData["CurrentFilter"] as string) ? "Chưa có phiếu mượn." : "Không tìm thấy phiếu mượn phù hợp.")</td></tr>
                }
                @foreach (var br in Model)
                {
                    var badgeClass = br.EffectiveStatus switch
                    {
                        BorrowStatuses.Overdue => "text-bg-danger",
                        BorrowStatuses.Returned => "text-bg-success",
                        _ => "text-bg-warning"
                    };
                    <tr>
                        <td class="fw-semibold">#@br.Id</td>
                        <td>
                            <div class="fw-medium">@br.Reader?.FullName</div>
                            <div class="small text-muted">@br.Reader?.Phone</div>
                        </td>
                        <td>
                            @foreach (var detail in br.BorrowDetails)
                            {
                                <div>@detail.Book?.Title <span class="text-muted small">(x@(detail.Quantity))</span></div>
                            }
                        </td>
                        <td>@br.BorrowDate.ToString("dd/MM/yyyy")</td>
                        <td>@br.DueDate.ToString("dd/MM/yyyy")</td>
                        <td>@(br.ReturnDate?.ToString("dd/MM/yyyy") ?? "—")</td>
                        <td>
                            <span class="badge rounded-pill @badgeClass">@br.EffectiveStatus</span>
                            @if (br.IsOverdue)
                            {
                                <div class="small text-danger mt-1">Trễ @br.OverdueDays ngày</div>
                            }
                        </td>
                        <td>
                            @if (br.ReturnDate == null)
                            {
                                <form asp-controller="Borrows" asp-action="Return" asp-route-id="@br.Id" method="post">
                                    <button class="btn btn-sm btn-outline-primary text-nowrap" type="submit"
                                            aria-label="Xác nhận trả phiếu #@br.Id">Xác nhận trả</button>
                                </form>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
