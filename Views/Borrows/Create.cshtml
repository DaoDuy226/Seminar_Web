@model CreateBorrowViewModel
@{
    ViewData["Title"] = "Lập phiếu mượn";
}

<section class="lib-page-header mb-4 d-flex flex-wrap justify-content-between align-items-center gap-3">
    <div>
        <span class="badge text-bg-warning text-dark mb-2">Mượn / Trả</span>
        <h1 class="h3 fw-bold mb-1">Lập phiếu mượn</h1>
        <p class="text-white-50 mb-0 small">Mỗi phiếu dùng cho một đầu sách.</p>
    </div>
    <a class="btn-lib btn-lib-ghost" asp-controller="Home" asp-action="Borrows"><span>← Về danh sách phiếu</span></a>
</section>

<div class="lib-panel p-4">
    <form asp-controller="Borrows" asp-action="Create" method="post">
        <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 mb-3" role="alert"></div>
        <div class="row g-3">
            <div class="col-md-6">
                <label asp-for="ReaderId" class="form-label fw-semibold"></label>
                <select asp-for="ReaderId" asp-items="Model.Readers" class="form-select">
                    <option value="">Chọn độc giả</option>
                </select>
                <span asp-validation-for="ReaderId" class="text-danger small"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="BookId" class="form-label fw-semibold"></label>
                <select asp-for="BookId" asp-items="Model.Books" class="form-select">
                    <option value="">Chọn sách</option>
                </select>
                <span asp-validation-for="BookId" class="text-danger small"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="Quantity" class="form-label fw-semibold"></label>
                <input asp-for="Quantity" class="form-control" />
                <span asp-validation-for="Quantity" class="text-danger small"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="DueDate" class="form-label fw-semibold"></label>
                <input asp-for="DueDate" class="form-control" />
                <span asp-validation-for="DueDate" class="text-danger small"></span>
            </div>
        </div>
        <div class="d-flex gap-2 mt-4">
            <button class="btn-lib btn-lib-navy" type="submit">Lưu phiếu mượn</button>
            <a class="btn-lib btn-lib-outline" asp-controller="Home" asp-action="Borrows">Hủy</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
