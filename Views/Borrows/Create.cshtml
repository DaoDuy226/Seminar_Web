@model CreateBorrowViewModel
@{
    ViewData["Title"] = "Lập phiếu mượn";
}

<section class="lib-page-header mb-4 d-flex flex-wrap justify-content-between align-items-center gap-3">
    <div>
        <h1 class="h3 fw-bold mb-1">Lập phiếu mượn</h1>
        <p class="text-white-50 mb-0">Mỗi phiếu dùng cho một đầu sách.</p>
    </div>
    <a class="btn-lib btn-lib-ghost" asp-controller="Home" asp-action="Borrows">Về danh sách phiếu</a>
</section>

<div class="lib-panel p-4">
    <form asp-controller="Borrows" asp-action="Create" method="post">
        <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
        <div class="row g-3">
            <div class="col-md-6">
                <label asp-for="ReaderId" class="form-label"></label>
                <select asp-for="ReaderId" asp-items="Model.Readers" class="form-select">
                    <option value="">Chọn độc giả</option>
                </select>
                <span asp-validation-for="ReaderId" class="text-danger"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="BookId" class="form-label"></label>
                <select asp-for="BookId" asp-items="Model.Books" class="form-select">
                    <option value="">Chọn sách</option>
                </select>
                <span asp-validation-for="BookId" class="text-danger"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="Quantity" class="form-label"></label>
                <input asp-for="Quantity" class="form-control" />
                <span asp-validation-for="Quantity" class="text-danger"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="DueDate" class="form-label"></label>
                <input asp-for="DueDate" class="form-control" />
                <span asp-validation-for="DueDate" class="text-danger"></span>
            </div>
        </div>
        <div class="mt-4">
            <button class="btn btn-primary" type="submit">Lưu phiếu mượn</button>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
